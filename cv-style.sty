% Degree and discipline retain separate typographic roles.
\newcommand{\degreefield}[2]{{\bfseries #1}\enspace{\color{muted}\textbar}\enspace{\itshape #2}}

% Consecutive positions at one institution. The group stays together on a page.
\RequirePackage{tikz}
\newcounter{careerposition}
\newlength{\careertextwidth}
\newenvironment{positiongroup}[2]{%
  \par\addvspace{7pt}\noindent\begin{minipage}{\linewidth}
  {\bfseries\fontsize{11}{14}\selectfont #1}\hfill{\fontsize{9}{12}\selectfont\color{muted}#2}\par\vspace{6pt}
  \setcounter{careerposition}{0}%
  \setlength{\careertextwidth}{\dimexpr\linewidth-15pt\relax}%
  \hspace*{2pt}\begin{tikzpicture}
}{\end{tikzpicture}\end{minipage}\par\vspace{3pt}}
\newcommand{\careerrole}[3]{%
  \stepcounter{careerposition}%
  \ifnum\value{careerposition}=1
    \coordinate (careerstart) at (0,0);
  \else
    \coordinate (careerstart) at ([yshift=-9pt]careerprevious.south west);
  \fi
  \node[anchor=north west,inner sep=0pt,outer sep=0pt,text width=\careertextwidth] (careerrole\arabic{careerposition}) at (careerstart) {%
    \cvrole{#1}\hfill\cvdate{#2}\par
    #3};
  \coordinate (careerdot\arabic{careerposition}) at ([xshift=-11pt,yshift=-5.5pt]careerrole\arabic{careerposition}.north west);
  \ifnum\value{careerposition}>1
    \draw[hairline,line width=1pt] (careerlastdot) -- (careerdot\arabic{careerposition});
  \fi
  \fill[accent!55] (careerdot\arabic{careerposition}) circle (2pt);
  \coordinate (careerlastdot) at (careerdot\arabic{careerposition});
  \node[inner sep=0pt,outer sep=0pt,anchor=north west,minimum width=0pt,minimum height=0pt] (careerprevious) at (careerrole\arabic{careerposition}.south west) {};
}

