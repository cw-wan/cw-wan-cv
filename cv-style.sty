% Shared summary/experience body typography, including text inside TikZ nodes.
\newcommand{\cvbody}{\normalfont\fontsize{10.2}{12.8}\selectfont\color{ink}}
\newcommand{\cvsmall}{\normalfont\fontsize{9.3}{11}\selectfont}
% Restore normal line-breaking rules even inside minipages and TikZ nodes.
\newcommand{\cvjustify}{\justifying\fussy\setlength{\emergencystretch}{1em}}
\newcommand{\cvinstitution}[1]{{\normalfont\bfseries\fontsize{11}{14}\selectfont\color{ink}#1}}
\newcommand{\cvsummary}[1]{{\cvbody #1\par}}
% Shared secondary-text size; dates retain their muted blue-gray color.
\newcommand{\cvdate}[1]{{\cvsmall\color{muted}#1}}
\color{ink}
\RequirePackage{enumitem}
\RequirePackage{titlesec}
\RequirePackage{fancyhdr}
\RequirePackage{needspace}
\RequirePackage{hyperref}
\hypersetup{colorlinks=true,urlcolor=accent,linkcolor=accent,citecolor=accent,pdftitle={Chenwei (Sky) Wan | Curriculum Vitae},pdfauthor={Chenwei (Sky) Wan},pdfsubject={Research experience and publications},bookmarksopen=true}
\urlstyle{same}
\pagestyle{fancy}
\fancyhf{}
\fancyhead[L]{\fontsize{8}{10}\selectfont\color{muted}CHENWEI (SKY) WAN}
\fancyhead[R]{\fontsize{8}{10}\selectfont\color{muted}CURRICULUM VITAE}
\fancyfoot[L]{\cvdate{Nov. 2026}}
\fancyfoot[R]{\fontsize{8}{10}\selectfont\color{muted}\thepage}
\renewcommand{\headrulewidth}{0pt}
\renewcommand{\footrulewidth}{0pt}
\setlength{\parindent}{0pt}
\setlength{\JustifyingParindent}{0pt}
\setlength{\parskip}{1pt}
\AtBeginDocument{\cvbody}
\cvjustify
\titleformat{\section}{\displayfont\fontsize{16}{18}\selectfont\color{heading}}{}{0pt}{}[\vspace{4pt}{\color{hairline}\titlerule[0.45pt]}]
\titlespacing*{\section}{0pt}{8pt}{7pt}
\setlist[itemize]{leftmargin=12pt,label=\textcolor{accent}{\textbullet},itemsep=1.5pt,topsep=3pt,parsep=0pt,partopsep=0pt,before={\cvbody\cvjustify}}
% Shared role/department style for individual and grouped appointments.
\newcommand{\cvrole}[2]{%
  {\cvbody\itshape #1}%
  \if\relax\detokenize{#2}\relax\else
    \nobreak\enspace{\cvbody\color{muted}\textbar}\nobreak\enspace
    {\cvbody\mbox{#2}}%
  \fi}
\newcommand{\entry}[5]{\Needspace{5\baselineskip}\vspace{5pt}\cvinstitution{#1}\hfill\cvdate{#2}\par\vspace{-1pt}\cvrole{#3}{#4}\hfill{\cvsmall\color{muted}#5}\par}
\newcommand{\detail}[1]{{\cvsmall\color{muted}#1\par}}
% Talk metadata follows the same institution/date pattern as experience.
\newcommand{\talktype}[1]{\begingroup\setlength{\fboxsep}{1.5pt}%
  \colorbox{accent!10}{\cvbody\color{accent}#1}\endgroup}
\newcommand{\talkentry}[4]{%
  \par\addvspace{4pt}\noindent\begin{minipage}{\linewidth}
    \setlength{\parskip}{1pt}%
    \noindent\cvbody\textbf{#1}\hfill\cvdate{#2}\par
    \noindent\begin{minipage}[t]{\dimexpr\linewidth-28mm\relax}
      \noindent\cvbody\itshape\cvjustify #4\par
    \end{minipage}\hspace{3mm}%
    \begin{minipage}[t]{25mm}
      \raggedleft\talktype{#3}\par
    \end{minipage}%
  \end{minipage}\par}
\newcommand{\pubcite}[1]{\cite{#1}}
\newcommand{\pubtitle}[2]{\if\relax\detokenize{#1}\relax{\color{ink}\mdseries\itshape #2}\else\href{#1}{\color{ink}\mdseries\itshape #2}\fi}
\newcommand{\pubauthors}[1]{{\cvbody #1}}
\newcommand{\pubvenue}[1]{{\cvbody\bfseries\itshape\color{accent}#1}}
\newcommand{\pubnote}[1]{{\cvsmall\color{muted}#1}}
\newcommand{\publicationlegend}{{\cvsmall\color{muted}%
  \mbox{C = Conference paper}\qquad\mbox{J = Journal paper}\qquad
  \mbox{* = Equal contribution}\qquad
  \mbox{\textdagger{} = Corresponding author}\par}}
\newcommand{\pubyear}[1]{\par\addvspace{5pt}\Needspace{6\baselineskip}%
  {\cvbody\bfseries\color{heading}#1\par}\nobreak\vspace{3pt}}
\definecolor{pubshade}{HTML}{F0F4F8}
% Keep each publication together; tint first- or equal-first-author entries.
\NewDocumentEnvironment{pubentry}{m +b}{%
  \begingroup\setlength{\fboxsep}{3pt}%
  \def\pubentrycolor{white}\ifnum#1=1\def\pubentrycolor{pubshade}\fi
  \noindent\hspace*{-3pt}\colorbox{\pubentrycolor}{%
    \begin{minipage}[t]{\dimexpr\linewidth-3pt\relax}%
      \noindent\cvbody\cvjustify\setlength{\parskip}{2pt}#2\par
    \end{minipage}}\par
  \endgroup
}{}
\makeatletter
\renewenvironment{thebibliography}[1]{%
  \list{\@biblabel{\@arabic\c@enumiv}}{\settowidth\labelwidth{C99.}\leftmargin\labelwidth\advance\leftmargin\labelsep\usecounter{enumiv}\setlength{\itemsep}{4pt}\setlength{\parsep}{2pt}\setlength{\topsep}{0pt}\setlength{\partopsep}{0pt}}%
  \cvbody\cvjustify\clubpenalty=10000\widowpenalty=10000
}{\endlist}
\renewcommand{\@biblabel}[1]{{\cvsmall\color{muted}#1.}}
\makeatother

\fancypagestyle{firstpage}{\fancyhead{}}

% Rebalance first-page whitespace only after TeX has selected the page break.
% Move 60% of the natural bottom slack above the name, capped at 8 mm.
% Measuring a copy leaves pagination, internal spacing and later pages intact.
\newlength{\cvheadroomlimit}
\setlength{\cvheadroomlimit}{8mm}
\makeatletter
\newbox\cv@naturalpage
\newdimen\cv@headroom
\let\cv@texttop\@texttop
\def\@texttop{%
  \cv@texttop
  \ifnum\c@page=1\relax
    \setbox\cv@naturalpage=\vbox{\unvcopy\@outputbox}%
    \cv@headroom=\dimexpr\@colht-\ht\cv@naturalpage\relax
    \cv@headroom=.6\cv@headroom
    \ifdim\cv@headroom>\cvheadroomlimit
      \cv@headroom=\cvheadroomlimit
    \fi
    \ifdim\cv@headroom>\z@\vskip\cv@headroom\fi
  \fi}
\makeatother

% Semantic highlight tags. Default: deep navy; override color per .bib entry.
\definecolor{oral}{HTML}{24486B}
\definecolor{award}{HTML}{395A72}
\definecolor{spotlight}{HTML}{39688A}
\newcommand{\pubhighlight}[2][oral]{\begingroup\setlength{\fboxsep}{3.5pt}\colorbox{#1!12}{\fontsize{7.5}{9}\selectfont\bfseries\color{#1}\MakeUppercase{#2}}\endgroup}

% Degree and discipline retain separate typographic roles.
\newcommand{\degreefield}[2]{{\bfseries #1}\enspace{\color{muted}\textbar}\enspace{\itshape #2}}

% Consecutive positions at one institution. The group stays together on a page.
\RequirePackage{tikz}
\newcounter{careerposition}
\newlength{\careertextwidth}
\newenvironment{positiongroup}[2]{%
  \par\addvspace{5pt}\noindent\begin{minipage}{\linewidth}
  \cvinstitution{#1}\hfill\cvdate{#2}\par\vspace{2.5pt}
  \setcounter{careerposition}{0}%
  \setlength{\careertextwidth}{\dimexpr\linewidth-15pt\relax}%
  \hspace*{2pt}\begin{tikzpicture}
}{\end{tikzpicture}\end{minipage}\par\vspace{1pt}}
\newcommand{\careerrole}[5]{%
  \stepcounter{careerposition}%
  \ifnum\value{careerposition}=1
    \coordinate (careerstart) at (0,0);
  \else
    \coordinate (careerstart) at ([yshift=-6pt]careerprevious.south west);
  \fi
  \node[anchor=north west,inner sep=0pt,outer sep=0pt,text width=\careertextwidth,
    font=\cvbody,text=ink,align=justify] (careerrole\arabic{careerposition}) at (careerstart) {%
    % TikZ creates a minipage: restore the document's paragraph spacing here.
    \setlength{\parskip}{1pt}%
    \cvjustify
    \cvrole{#1}{#2}\hfill\mbox{\cvdate{#3;\enspace #4}}\par
    #5};
  \coordinate (careerdot\arabic{careerposition}) at ([xshift=-11pt,yshift=-5.5pt]careerrole\arabic{careerposition}.north west);
  \ifnum\value{careerposition}>1
    \draw[hairline,line width=1pt] (careerlastdot) -- (careerdot\arabic{careerposition});
  \fi
  \fill[accent!55] (careerdot\arabic{careerposition}) circle (2pt);
  \coordinate (careerlastdot) at (careerdot\arabic{careerposition});
  \node[inner sep=0pt,outer sep=0pt,anchor=north west,minimum width=0pt,minimum height=0pt] (careerprevious) at (careerrole\arabic{careerposition}.south west) {};
}

% School logos span the institution and degree lines only.
\RequirePackage{graphicx}
