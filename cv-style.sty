  \hspace{3.5pt}#2}}
\newcommand{\contactsep}{\hspace{13pt}}

\newcommand{\educationentry}[6]{%
  \par\addvspace{5pt}\noindent
  \begin{minipage}[c]{9mm}
    \includegraphics[width=9mm,height=9mm,keepaspectratio]{#1}
  \end{minipage}\hspace{3mm}%
  \begin{minipage}[c]{\dimexpr\linewidth-12mm\relax}
    {\bfseries\fontsize{11}{14}\selectfont #2}\hfill\cvdate{#3}\par
    {\color{ink}#4}\hfill{\fontsize{9}{12}\selectfont\color{muted}#5}\par
  \end{minipage}\par\vspace{2pt}
  \noindent\hspace*{12mm}\begin{minipage}{\dimexpr\linewidth-12mm\relax}
    #6
  \end{minipage}\par
}
